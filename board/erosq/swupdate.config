#
# EROS Q swupdate configuration.
# Based on buildroot-2026.05/package/swupdate/swupdate.config, flipped for:
#   - LEAN build (32MB RAM target): no webserver/mongoose, no suricatta,
#     no systemd, no Lua, no curl download.
#   - mbedTLS crypto backend (not openssl) for on-device size.
#   - U-Boot (libubootenv) bootloader support for A/B slot switching.
#   - RSA-PSS signed-image verification (CONFIG_SIGNED_IMAGES + HASH_VERIFY).
#   - ubivol handler for writing UBI volumes (SPI-NAND rootfs).
#
# NOTE: this file is copied verbatim as swupdate's .config and then run
# through `olddefconfig`, which SILENTLY DROPS any symbol name that does not
# exist in this swupdate version's Kconfig (e.g. wrong/renamed option) rather
# than erroring. The features below were confirmed post-build via readelf on
# the built swupdate binary and the resolved .config in the build dir; do not
# add new options here without repeating that verification.
#
CONFIG_HAVE_DOT_CONFIG=y

#
# General Configuration
#
# CONFIG_CURL is not set
# CONFIG_CURL_SSL is not set
# CONFIG_SYSTEMD is not set
CONFIG_DEFAULT_CONFIG_FILE="/etc/swupdate.cfg"
CONFIG_SCRIPTS=y
# CONFIG_HW_COMPATIBILITY is not set
CONFIG_SW_VERSIONS_FILE="/etc/sw-versions"

#
# Socket Paths
#
CONFIG_SOCKET_CTRL_PATH="/tmp/sockinstctrl"
CONFIG_SOCKET_PROGRESS_PATH="/tmp/swupdateprog"
CONFIG_SOCKET_REMOTE_HANDLER_DIRECTORY="/tmp/"

# CONFIG_FEATURE_SYSLOG is not set

#
# Build Options
#
CONFIG_CROSS_COMPILE=""
CONFIG_SYSROOT=""
CONFIG_EXTRA_CFLAGS=""
CONFIG_EXTRA_LDFLAGS=""
CONFIG_EXTRA_LDLIBS=""

#
# Debugging Options
#
# CONFIG_DEBUG is not set
# CONFIG_WERROR is not set
# CONFIG_NOCLEANUP is not set

#
# Bootloader interface: U-Boot via libubootenv (A/B slot switching)
# NOTE: the real Kconfig symbol is CONFIG_UBOOT (there is no
# CONFIG_BOOTLOADER_UBOOT — that name from the task brief does not exist in
# swupdate 2025.05's bootloader/Kconfig and would be silently dropped by
# olddefconfig).
#
# CONFIG_BOOTLOADER_NONE is not set
# CONFIG_BOOTLOADER_EBG is not set
CONFIG_UBOOT=y
CONFIG_BOOTLOADER_DEFAULT_UBOOT=y

#
# SSL/crypto backend: mbedTLS (not openssl) for on-device size
#
# CONFIG_SSL_IMPL_NONE is not set
CONFIG_SSL_IMPL_MBEDTLS=y
# CONFIG_SSL_IMPL_OPENSSL is not set
# CONFIG_SSL_IMPL_WOLFSSL is not set

#
# Hash checking / signed-image verification (RSA-PSS)
#
CONFIG_HASH_VERIFY=y
CONFIG_SIGNED_IMAGES=y
# swupdate >= 2026.05 makes SIGALG a multi-select with PKCS#1.5 default y: pin PSS-only.
# CONFIG_SIGALG_RAWRSA is not set
CONFIG_SIGALG_RSAPSS=y

# No image encryption

#
# No download / no remote server (LEAN build)
#
# CONFIG_SURICATTA is not set
# CONFIG_WEBSERVER is not set
# CONFIG_MONGOOSE is not set
# CONFIG_MONGOOSEIPV6 is not set

#
# Parser Features
#
CONFIG_LIBCONFIG=y
CONFIG_PARSERROOT=""
# CONFIG_SETSWDESCRIPTION is not set

#
# Image Handlers
#
CONFIG_UBIVOL=y
# CONFIG_DISKPART is not set
CONFIG_RAW=y
# CONFIG_RDIFFHANDLER is not set
CONFIG_SHELLSCRIPTHANDLER=y

# No archive/zeromq/swuforward/microcontroller handlers needed
CONFIG_BOOTLOADERHANDLER=y
