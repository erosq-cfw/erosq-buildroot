# Installer kernel: merged onto the erosq kernel .config (LINUX_SHA).
# It must stay under the stock bootloader's 4 MiB read (check-uimage.sh), so
# everything an installer does not need is off. It keeps NAND (SFC + SPI-NAND
# + UBI), the SD card (MMC + VFAT), loop + ISO9660 (to mount update.upt), the
# PMIC (AXP2101: poweroff, and the battery the write gates read), the panel
# with a framebuffer console, so the owner can watch the log on the screen
# (there is no serial port for them), and, for the rescue menu, the buttons
# and a USB drive mode.
CONFIG_BLK_DEV_INITRD=y
CONFIG_MIPS_RAW_APPENDED_DTB=y
# CONFIG_MIPS_NO_APPENDED_DTB is not set
# CONFIG_BUILTIN_DTB_ALL is not set
CONFIG_BLK_DEV_LOOP=y
CONFIG_ISO9660_FS=y
# The command line is installer.dts's bootargs (MIPS_CMDLINE_FROM_DTB; there
# is no built-in one: CMDLINE_BOOL is off). No earlycon there or anywhere: it
# touches UART2 before its clock is on, and the stock bootloader leaves that
# clock gated (a silent hang). ci/installer.sh refuses it in CONFIG_CMDLINE.
# CONFIG_SOUND is not set
# CONFIG_NET is not set
# USB device side only, for the rescue menu's USB drive mode: the DWC2
# controller as a configfs mass-storage gadget. No host side, no legacy
# gadget (one would take the controller at boot), no network function.
CONFIG_USB_SUPPORT=y
# CONFIG_USB is not set
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_PERIPHERAL=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
# CONFIG_USB_CONFIGFS_ECM is not set
# CONFIG_USB_MASS_STORAGE is not set
# CONFIG_USB_ETH is not set
# The AXP2101 battery: the rescue menu's write gates and USB drive mode read
# its capacity and status. The firmware config has it; listed so it stays.
CONFIG_POWER_SUPPLY=y
CONFIG_BATTERY_AXP2101=y
# The buttons, for the rescue menu: the gpio-keys node of the board DT and
# evdev. VT selects INPUT anyway, so INPUT was never really off; the rest of
# the input drivers are.
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_GPIO=y
# CONFIG_KEYBOARD_GPIO_POLLED is not set
# CONFIG_INPUT_MISC is not set
# CONFIG_INPUT_MOUSE is not set
# CONFIG_INPUT_MOUSEDEV is not set
# CONFIG_INPUT_JOYSTICK is not set
# CONFIG_INPUT_TABLET is not set
# CONFIG_INPUT_TOUCHSCREEN is not set
# CONFIG_SERIO is not set
# CONFIG_HID_SUPPORT is not set
# CONFIG_ZRAM is not set
# CONFIG_ZSMALLOC is not set
# CONFIG_SWAP is not set
# CONFIG_DMA_CMA is not set
# CONFIG_CMA is not set
# CONFIG_CPU_FREQ is not set
# CONFIG_KALLSYMS is not set
# CONFIG_FTRACE is not set
# CONFIG_PROFILING is not set
# CONFIG_BLK_DEV_BSG is not set
# CONFIG_IKCONFIG is not set
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FB=y
CONFIG_FB_CORE=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_CLIENT_SELECTION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONT_SUPPORT=y
CONFIG_FONT_8x8=y
